  "keyFeatures": [
    "Wishes — aspirational events with no fixed date that friends can express interest in",
    "Plans — concrete events with a date, time, and participant capacity",
    "Wish-to-Plan conversion — turn a casual wish into a scheduled plan and notify all interested friends",
    "Friends system — friend requests, search, and personal invite links for off-platform users",
    "Visibility control — share events with friends-only or friends-of-friends",
    "In-app notifications and email reminders for events and friend activity",
    "Profile with avatar, bio, city, and privacy settings",
    "Google OAuth and email/OTP sign-in",
    "Shareable event deep links with cover images",
    "Mobile app for iOS and Android via Expo"
  ],
  "publicApiSurface": [
    "POST /api/user/auth/email-start/ — initiate email sign-up or login",
    "POST /api/user/auth/verify-code/ — verify OTP code",
    "POST /api/user/auth/set-password/ — complete registration",
    "POST /api/user/auth/token/ — email/password login",
    "POST /api/user/auth/token/refresh/ — refresh JWT",
    "POST /api/user/auth/logout/ — log out",
    "POST /api/user/auth/google/ — Google OAuth login",
    "POST /api/user/auth/reset-password/ — request password reset",
    "POST /api/user/auth/set-new-password/ — set new password",
    "GET/PATCH /api/user/profile/ — view and update profile",
    "POST /api/user/profile/avatar/ — upload avatar",
    "GET /api/user/users/ — search users",
    "GET /api/user/users/{id}/friends/ — list a user's friends",
    "GET /api/user/users/{id}/events/ — list a user's events",
    "GET /api/user/friendship/ — list friendships",
    "POST /api/user/friendship/send/ — send a friend request",
    "POST /api/user/friendship/{id}/accept/ — accept a friend request",
    "POST /api/user/friendship/{id}/decline/ — decline a friend request",
    "DELETE /api/user/friendship/{id}/ — remove a friend",
    "POST /api/user/invite/ — generate an invite link",
    "POST /api/user/invite/use/ — redeem an invite link",
    "GET /api/event/events/ — list events (social feed)",
    "POST /api/event/events/ — create a wish or plan",
    "GET /api/event/events/{id}/ — get event details",
    "PATCH /api/event/events/{id}/ — update an event",
    "DELETE /api/event/events/{id}/ — delete an event",
    "POST /api/event/events/{id}/join/ — join a plan",
    "POST /api/event/events/{id}/interested/ — mark interest in a wish",
    "POST /api/event/events/{id}/leave/ — leave an event",
    "POST /api/event/events/{id}/convert/ — convert wish to plan",
    "POST /api/event/events/{id}/share/ — create/manage a share link",
    "GET /api/event/share/{token}/ — view shared event preview",
    "GET /api/event/category/ — list event categories",
    "GET /api/notifications/ — list notifications",
    "POST /api/notifications/{id}/mark_as_read/ — mark notification read",
    "POST /api/notifications/read_all/ — mark all notifications read",
    "GET /api/notifications/unread_count/ — get unread notification count",
    "GET /api/username-check/?username={username} — check username availability"
  ]
}
